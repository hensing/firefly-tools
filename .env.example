# Example settings. Copy to .env (git-ignored) and fill in:
#     cp .env.example .env
# The scripts read .env when run locally; real environment variables win.
# For the container pass the same file with --env-file (docker does not strip
# quotes there, so leave values unquoted in a file you use that way).

# --- required -------------------------------------------------------------
FIREFLY_URL=https://firefly.example.com
# Firefly: Options > Profile > OAuth > Personal Access Tokens
FIREFLY_TOKEN=paste-your-personal-access-token-here

# --- optional -------------------------------------------------------------
# Extra request header "X-Firefly-Gate", if a reverse proxy in front of Firefly asks for one
#FIREFLY_HEADER_SECRET=choose-a-long-random-string

# ff_subscriptions.py: order of the groups on the subscriptions page
# (default: the order the table first names them)
#SUBSCRIPTION_GROUPS="Home,Streaming,Server,Other"

# ff_postprocess.py: mail for problems and the forecast (without SMTP_HOST it only prints)
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=firefly@example.com
#SMTP_PASSWORD=your-smtp-password
#MAIL_FROM=firefly@example.com
#MAIL_TO=you@example.com

# import_amex.sh / import_mm.sh: the Data Importer's /autoupload
# (IMPORTER_SECRET = its AUTO_IMPORT_SECRET, at least 16 characters; the
# importer also needs CAN_POST_FILES=true)
#IMPORTER_URL=https://firefly-importer.example.com
#IMPORTER_SECRET=the-importers-auto-import-secret
